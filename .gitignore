# Root-level ignores. Per-project ignores also live in backend/.gitignore
# and frontend/.gitignore.

# Environment files (never commit secrets; *.example files are tracked)
.env
.env.*
!.env.example
!.env.prod.example
!.env.local.example

# OS/editor cruft
.DS_Store
Thumbs.db

frontend/test-results/
frontend/playwright-report/
