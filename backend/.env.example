# Copy this file to `.env` for local tooling that reads dotenv files, or
# export these as real environment variables before running the backend.
# Never commit a real `.env` file (see .gitignore).

# Required. Postgres connection string.
# Local dev (matches docker-compose.yml at repo root):
DATABASE_URL=postgres://plantshop:plantshop@localhost:5432/plantshop
# In docker-compose.prod.yml this is provided as an env var on the
# `backend` service and points at the `postgres` service by name instead
# of localhost.

# Optional. Port the HTTP server listens on. Defaults to 8080.
PORT=8080

# Optional. "development" (default) or "production".
# In production, session cookies are marked Secure (requires HTTPS).
# Keep this as "development" for local HTTP testing.
APP_ENV=development

# ZarinPal Payment V1. Required to accept real ZarinPal payments; if unset,
# the payment endpoints stay registered but every request to ZarinPal will
# fail (an empty merchant_id is always rejected by the gateway).

# Your 36-character ZarinPal Merchant ID. NEVER commit a real value here —
# this file only ever holds a placeholder.
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The full, publicly reachable URL ZarinPal redirects the customer's
# browser back to after the gateway flow completes. Must point at this
# backend's callback route. A real production gateway requires this to be
# a publicly reachable HTTPS domain — "http://localhost:8080/..." only
# works while testing against ZarinPal's sandbox from your own machine with
# a tunnel (e.g. ngrok); it is never suitable for real production traffic,
# since ZarinPal's servers/the customer's browser cannot reach your
# localhost.
ZARINPAL_CALLBACK_URL=http://localhost:8080/api/v1/payments/zarinpal/callback

# Optional. "true" to use ZarinPal's sandbox environment (no real money
# moves), anything else (including unset) uses production. Always use the
# sandbox while developing/testing.
ZARINPAL_SANDBOX=true
