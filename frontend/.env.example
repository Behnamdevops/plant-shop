# Copy this file to `.env` (or `.env.local`) to customize store branding
# for local development. Both values are optional — the app works with
# sensible defaults ("Plant Shop" / "$") if this file is absent.
# Never commit a real `.env` file (see .gitignore).

# Display name shown in the header, homepage heading, and document title.
VITE_STORE_NAME=Plant Shop

# Currency symbol prefixed to prices in the UI.
VITE_CURRENCY_SYMBOL=$
