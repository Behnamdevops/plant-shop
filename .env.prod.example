# Example env file for docker-compose.prod.yml.
# Copy to `.env.prod` (untracked — see .gitignore) and fill in real values.
# Never commit the real .env.prod file.

# Postgres credentials used by both the postgres and backend services.
POSTGRES_USER=plantshop
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=plantshop

# Host port the frontend (nginx) is published on. The app is reachable at
# http://localhost:${FRONTEND_PORT} once the stack is up.
FRONTEND_PORT=8081

# Store branding baked into the frontend build (see frontend/.env.example
# for local-dev equivalents). Optional — defaults to "Plant Shop" / "$".
VITE_STORE_NAME=Plant Shop
VITE_CURRENCY_SYMBOL=$

# ZarinPal Payment V1 (backend). Never commit real values.
#
# ZARINPAL_CALLBACK_URL MUST be a publicly reachable HTTPS URL pointing at
# your production domain's /api/v1/payments/zarinpal/callback route (e.g.
# https://shop.example.com/api/v1/payments/zarinpal/callback) — ZarinPal's
# servers and the customer's browser must be able to reach it from the
# public internet. A localhost or private-network URL will not work for
# real production traffic.
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_CALLBACK_URL=https://your-production-domain.example.com/api/v1/payments/zarinpal/callback
# Set to "false" (or omit) once you are ready to accept real payments.
ZARINPAL_SANDBOX=true
